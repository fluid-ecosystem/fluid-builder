<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mua.fluid</groupId>
    <artifactId>fluid-builder</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Fluid Builder</name>
    <description>Tiny, agile Java microservice framework for Kafka</description>

    <!--
      This POM does not replace the source launcher. The Docker image still
      runs the flat .java files directly:

          CMD java DependencyDownloader.java && java -cp $(java ListDependency.java) Fluid.java

      Maven exists here for tests, linting and CI gating only. Its output is
      never shipped. To keep one source of truth, it compiles the very same
      files in place rather than a copy under src/main/java.
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
          The container base image is Java 24 and compiles the sources itself
          at start-up. Pinning release to 24 is what stops a Java 25+ only
          construct reaching main and breaking the container at runtime,
          which no test would otherwise catch. Build on 24 or newer.
        -->
        <maven.compiler.release>24</maven.compiler.release>

        <!-- Must match DependencyDownloader.MINIMAL_REQUIRED_DEPS. -->
        <gson.version>2.8.9</gson.version>
        <slf4j.api.version>2.0.17</slf4j.api.version>
        <slf4j.simple.version>2.0.7</slf4j.simple.version>
        <kafka.version>3.7.1</kafka.version>
        <spotbugs.version>4.8.3</spotbugs.version>

        <junit.version>5.10.1</junit.version>
        <mockito.version>5.8.0</mockito.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.api.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.simple.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
            <!--
              kafka-clients pulls snappy-java, lz4-java and zstd-jni
              transitively. DependencyDownloader fetches none of them, so
              leaving them in would give Maven a classpath the container does
              not have: compression.type=snappy would pass CI and fail at
              runtime. Excluded so this build tests what actually ships.

              Adding a codec means adding it here AND to
              DependencyDownloader.MINIMAL_REQUIRED_DEPS.
            -->
            <exclusions>
                <exclusion>
                    <groupId>org.xerial.snappy</groupId>
                    <artifactId>snappy-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.lz4</groupId>
                    <artifactId>lz4-java</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.luben</groupId>
                    <artifactId>zstd-jni</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs.version}</version>
            <!-- jsr305 is transitive here and absent from the container. -->
            <exclusions>
                <exclusion>
                    <groupId>com.google.code.findbugs</groupId>
                    <artifactId>jsr305</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The flat, package-less sources at the repository root. -->
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/java</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!--
                      sourceDirectory is the repo root, so everything that is
                      not framework source has to be kept out explicitly.
                      examples/ still carries com.fluid.enhanced packages and
                      does not belong to this artifact.
                    -->
                    <excludes>
                        <exclude>examples/**</exclude>
                        <exclude>src/**</exclude>
                        <exclude>target/**</exclude>
                    </excludes>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
